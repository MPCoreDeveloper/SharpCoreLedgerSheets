@page
@model SharpCoreLedgerSheets.Web.Pages.BankImportModel
@using System.Globalization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MenuBankImport"];
}
<h1>@L["MenuBankImport"]</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="melding">@Model.ErrorMessage</div>
}

@if (Model.Result is { } result)
{
    <div class="melding">
        @L["ImportResult", result.Read, result.Added, result.Skipped]
        @if (result.AllAlreadyKnown)
        {
            <span class="muted">@L["AllAlreadyKnown"]</span>
        }
    </div>
}

<h3>@L["StatementImport"]</h3>
<form method="post" asp-page-handler="Import" enctype="multipart/form-data">
    <div class="velden">
        <div class="veld">
            <label for="bankrekening">@L["BankAccount"]</label>
            <select id="bankrekening" name="BankAccountNumber" required>
                @foreach (var account in Model.AllAccounts)
                {
                    <option value="@account.Number" selected="@(Model.BankAccountNumber == account.Number)">
                        @account.Number — @account.Name
                    </option>
                }
            </select>
        </div>
        <div class="veld">
            <label for="format">@L["Format"]</label>
            <select id="format" name="Format">
                <option value="">@L["Automatic"]</option>
                @foreach (var format in Model.Formaten)
                {
                    <option value="@format" selected="@(Model.Format == format)">@L[format.ToString()]</option>
                }
            </select>
        </div>
        <div class="veld">
            <label for="statementFile">@L["File"]</label>
            <input id="statementFile" name="StatementFile" type="file" accept=".xml,.csv,.txt" required />
        </div>
    </div>
    <button type="submit">@L["Import"]</button>
</form>

<h3>@L["OpenMovements"]</h3>
<table>
    <thead>
    <tr>
        <th>@L["Date"]</th>
        <th>@L["Amount"]</th>
        <th>@L["Name"]</th>
        <th>@L["Description"]</th>
        <th>@L["Reference"]</th>
        <th>@L["Proposal"]</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @if (Model.Lines.Count == 0)
    {
        <tr><td colspan="7" class="muted">@L["NoData"]</td></tr>
    }
    @foreach (var line in Model.Lines)
    {
        <tr>
            <td>@line.Transaction.Date.ToString("d", CultureInfo.CurrentCulture)</td>
            <td>@line.Transaction.Movement.Value.ToString("N2", CultureInfo.CurrentCulture)</td>
            <td>@line.Transaction.CounterpartyName</td>
            <td>@line.Transaction.Description</td>
            <td>@line.Transaction.Reference</td>
            <td>
                @if (line.Proposal is { } proposal)
                {
                    <span title="@proposal.Reason">
                        @proposal.CounterAccountNumber — @proposal.CounterAccountName
                        (@L["Confidence"]: @proposal.Confidence)
                    </span>
                }
                else
                {
                    <span class="muted">@L["NoProposal"]</span>
                }
            </td>
            <td>
                <form method="post" asp-page-handler="Post">
                    <input type="hidden" name="TransactionId" value="@line.Transaction.Id" />
                    <select name="CounterAccountNumber" aria-label="@L["CounterAccount"]" required>
                        @foreach (var account in Model.AllAccounts)
                        {
                            var proposed = line.Proposal is { IsReliable: true } proposal
                                && proposal.CounterAccountNumber == account.Number;
                            <option value="@account.Number" selected="@proposed">
                                @account.Number — @account.Name
                            </option>
                        }
                    </select>
                    <button type="submit">@L["Post"]</button>
                </form>
                <form method="post" asp-page-handler="Ignore">
                    <input type="hidden" name="TransactionId" value="@line.Transaction.Id" />
                    <button type="submit">@L["Ignore"]</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
