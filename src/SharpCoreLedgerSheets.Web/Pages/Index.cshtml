@page
@model SharpCoreLedgerSheets.Web.Pages.IndexModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MenuDashboard"];
    var overview = Model.Overview;
}
<h1>@L["MenuDashboard"]</h1>
<p class="lead">@L["OverviewDescription"]</p>

<form method="get" class="toolbar">
    <label for="year">@L["Year"]</label>
    <input id="year" name="year" type="number" min="1900" max="2999" value="@Model.Year" />
    <button type="submit">@L["MenuDashboard"]</button>
</form>

@if (Model.ErrorMessage is not null)
{
    <div class="melding">@Model.ErrorMessage</div>
}

@if (overview is not null)
{
    <div class="kaarten">
        <section>
            <h3>@L["BalanceSheet"]</h3>
            <table>
                <tbody>
                <tr>
                    <td>@L["Total"] @L["Assets"]</td>
                    <td class="amount">@(overview.BalanceSheet.TotalAssets.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Total"] @L["Liabilities"]</td>
                    <td class="amount">@(overview.BalanceSheet.TotalLiabilities.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Total"] @L["Equity"]</td>
                    <td class="amount">@(overview.BalanceSheet.EquityIncludingResult.ToString("N2"))</td>
                </tr>
                <tr class="total">
                    <td>@L["Result"]</td>
                    <td class="amount @(overview.BalanceSheet.Result < 0m ? "negative" : string.Empty)">@(overview.BalanceSheet.Result.ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
            <p>
                <span class="badge @(overview.BalanceSheet.IsBalanced ? "ok" : "warn")">
                    @(overview.BalanceSheet.IsBalanced ? L["Balanced"] : L["NotBalanced"])
                </span>
            </p>
        </section>

        <section>
            <h3>@L["ProfitAndLoss"]</h3>
            <table>
                <tbody>
                <tr>
                    <td>@L["Total"] @L["Revenue"]</td>
                    <td class="amount">@(overview.ProfitAndLoss.TotalRevenue.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Total"] @L["Costs"]</td>
                    <td class="amount">@(overview.ProfitAndLoss.TotalCosts.ToString("N2"))</td>
                </tr>
                <tr class="total">
                    <td>@L["Result"]</td>
                    <td class="amount @(overview.ProfitAndLoss.Result < 0m ? "negative" : string.Empty)">@(overview.ProfitAndLoss.Result.ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
        </section>

        <section>
            <h3>@L["CashFlowStatement"]</h3>
            <table>
                <tbody>
                <tr>
                    <td>@L["Operating"]</td>
                    <td class="amount @(overview.CashFlow.NetOperating < 0m ? "negative" : string.Empty)">@(overview.CashFlow.NetOperating.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Investing"]</td>
                    <td class="amount @(overview.CashFlow.NetInvesting < 0m ? "negative" : string.Empty)">@(overview.CashFlow.NetInvesting.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Financing"]</td>
                    <td class="amount @(overview.CashFlow.NetFinancing < 0m ? "negative" : string.Empty)">@(overview.CashFlow.NetFinancing.ToString("N2"))</td>
                </tr>
                <tr class="total">
                    <td>@L["NetMovement"]</td>
                    <td class="amount @(overview.CashFlow.NetMovement < 0m ? "negative" : string.Empty)">@(overview.CashFlow.NetMovement.ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
        </section>
    </div>

    <h2>@L["Ratio"]</h2>
    <div class="kaarten">
        <section>
            <table>
                <tbody>
                <tr>
                    <td>@L["CurrentRatio"]</td>
                    <td class="amount">@(overview.Ratio.CurrentRatio.HasValue ? overview.Ratio.CurrentRatio.Value.ToString("N2") : "–")</td>
                </tr>
                <tr>
                    <td>@L["QuickRatio"]</td>
                    <td class="amount">@(overview.Ratio.QuickRatio.HasValue ? overview.Ratio.QuickRatio.Value.ToString("N2") : "–")</td>
                </tr>
                </tbody>
            </table>
        </section>
        <section>
            <table>
                <tbody>
                <tr>
                    <td>@L["Solvency"]</td>
                    <td class="amount">@(overview.Ratio.Solvency.HasValue ? (overview.Ratio.Solvency.Value * 100m).ToString("N1") + "%" : "–")</td>
                </tr>
                <tr>
                    <td>@L["NetProfitMargin"]</td>
                    <td class="amount">@(overview.Ratio.NetProfitMargin.HasValue ? (overview.Ratio.NetProfitMargin.Value * 100m).ToString("N1") + "%" : "–")</td>
                </tr>
                <tr>
                    <td>@L["ReturnOnEquity"]</td>
                    <td class="amount">@(overview.Ratio.ReturnOnEquity.HasValue ? (overview.Ratio.ReturnOnEquity.Value * 100m).ToString("N1") + "%" : "–")</td>
                </tr>
                </tbody>
            </table>
        </section>
    </div>

    <p class="toolbar">
        <a href="@Url.Page("/Report", new { year = Model.Year })">@L["MenuReport"]</a>
    </p>
}
