@page
@model FinOverzicht.Web.Pages.BoekingenModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MenuBoekingen"];
}
<h1>@L["MenuBoekingen"]</h1>

<form method="get" class="toolbar">
    <label for="jaar">@L["Jaar"]</label>
    <input id="jaar" name="jaar" type="number" min="1900" max="2999" value="@Model.Jaar" />
    <button type="submit">@L["MenuBoekingen"]</button>
</form>

@if (Model.Foutmelding is not null)
{
    <div class="melding">@Model.Foutmelding</div>
}

@if (Model.AlleRekeningen.Count == 0)
{
    <div class="melding">@L["GeenGegevens"]</div>
}
else
{
    <h3>@L["Nieuw"]</h3>
    <form method="post" asp-route-jaar="@Model.Jaar">
        <div class="velden">
            <div class="veld">
                <label for="datum">@L["Datum"]</label>
                <input id="datum" name="Datum" type="date" value="@Model.Datum.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="veld">
                <label for="omschrijving">@L["Omschrijving"]</label>
                <input id="omschrijving" name="Omschrijving" value="@Model.Omschrijving" required maxlength="200" />
            </div>
            <div class="veld">
                <label for="referentie">@L["Referentie"]</label>
                <input id="referentie" name="Referentie" value="@Model.Referentie" maxlength="60" />
            </div>
            <div class="veld">
                <label for="debet">@L["Debet"] (@L["Rekening"])</label>
                <select id="debet" name="DebetRekening" required>
                    @foreach (var rekening in Model.AlleRekeningen)
                    {
                        <option value="@rekening.Nummer">@rekening.Nummer — @rekening.Naam</option>
                    }
                </select>
            </div>
            <div class="veld">
                <label for="credit">@L["Credit"] (@L["Rekening"])</label>
                <select id="credit" name="CreditRekening" required>
                    @foreach (var rekening in Model.AlleRekeningen)
                    {
                        <option value="@rekening.Nummer">@rekening.Nummer — @rekening.Naam</option>
                    }
                </select>
            </div>
            <div class="veld">
                <label for="bedrag">@L["Bedrag"]</label>
                <input id="bedrag" name="Bedrag" type="number" step="0.01" min="0.01" value="@Model.Bedrag" required />
            </div>
        </div>
        <button type="submit">@L["Boeken"]</button>
    </form>
}

<h3>@L["MenuBoekingen"] @Model.Jaar</h3>
<table>
    <thead>
    <tr>
        <th>@L["Datum"]</th>
        <th>@L["Omschrijving"]</th>
        <th>@L["Referentie"]</th>
        <th>@L["Bedrag"]</th>
    </tr>
    </thead>
    <tbody>
    @if (Model.Posten.Count == 0)
    {
        <tr><td colspan="4" class="muted">@L["GeenGegevens"]</td></tr>
    }
    @foreach (var post in Model.Posten)
    {
        <tr>
            <td>@post.Datum.ToString("d")</td>
            <td>@post.Omschrijving</td>
            <td>@post.Referentie</td>
            <td class="amount">@(post.TotaalDebet.ToString("N2"))</td>
        </tr>
    }
    </tbody>
</table>
