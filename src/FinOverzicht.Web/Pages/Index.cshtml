@page
@model FinOverzicht.Web.Pages.IndexModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MenuDashboard"];
    var overzicht = Model.Overzicht;
}
<h1>@L["MenuDashboard"]</h1>
<p class="lead">@L["OverzichtOmschrijving"]</p>

<form method="get" class="toolbar">
    <label for="jaar">@L["Jaar"]</label>
    <input id="jaar" name="jaar" type="number" min="1900" max="2999" value="@Model.Jaar" />
    <button type="submit">@L["MenuDashboard"]</button>
</form>

@if (Model.Foutmelding is not null)
{
    <div class="melding">@Model.Foutmelding</div>
}

@if (overzicht is not null)
{
    <div class="kaarten">
        <section>
            <h3>@L["Balans"]</h3>
            <table>
                <tbody>
                <tr>
                    <td>@L["Totaal"] @L["Activa"]</td>
                    <td class="amount">@(overzicht.Balans.TotaalActiva.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Totaal"] @L["Passiva"]</td>
                    <td class="amount">@(overzicht.Balans.TotaalPassiva.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Totaal"] @L["EigenVermogen"]</td>
                    <td class="amount">@(overzicht.Balans.EigenVermogenInclusiefResultaat.ToString("N2"))</td>
                </tr>
                <tr class="total">
                    <td>@L["Resultaat"]</td>
                    <td class="amount @(overzicht.Balans.Resultaat < 0m ? "negative" : string.Empty)">@(overzicht.Balans.Resultaat.ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
            <p>
                <span class="badge @(overzicht.Balans.IsInBalans ? "ok" : "warn")">
                    @(overzicht.Balans.IsInBalans ? L["InBalans"] : L["NietInBalans"])
                </span>
            </p>
        </section>

        <section>
            <h3>@L["WinstEnVerlies"]</h3>
            <table>
                <tbody>
                <tr>
                    <td>@L["Totaal"] @L["Opbrengsten"]</td>
                    <td class="amount">@(overzicht.WinstVerlies.TotaalOpbrengsten.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Totaal"] @L["Kosten"]</td>
                    <td class="amount">@(overzicht.WinstVerlies.TotaalKosten.ToString("N2"))</td>
                </tr>
                <tr class="total">
                    <td>@L["Resultaat"]</td>
                    <td class="amount @(overzicht.WinstVerlies.Resultaat < 0m ? "negative" : string.Empty)">@(overzicht.WinstVerlies.Resultaat.ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
        </section>

        <section>
            <h3>@L["Kasstroomoverzicht"]</h3>
            <table>
                <tbody>
                <tr>
                    <td>@L["Operationeel"]</td>
                    <td class="amount @(overzicht.Kasstroom.NettoOperationeel < 0m ? "negative" : string.Empty)">@(overzicht.Kasstroom.NettoOperationeel.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Investering"]</td>
                    <td class="amount @(overzicht.Kasstroom.NettoInvestering < 0m ? "negative" : string.Empty)">@(overzicht.Kasstroom.NettoInvestering.ToString("N2"))</td>
                </tr>
                <tr>
                    <td>@L["Financiering"]</td>
                    <td class="amount @(overzicht.Kasstroom.NettoFinanciering < 0m ? "negative" : string.Empty)">@(overzicht.Kasstroom.NettoFinanciering.ToString("N2"))</td>
                </tr>
                <tr class="total">
                    <td>@L["NettoMutatie"]</td>
                    <td class="amount @(overzicht.Kasstroom.NettoMutatie < 0m ? "negative" : string.Empty)">@(overzicht.Kasstroom.NettoMutatie.ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
        </section>
    </div>

    <h2>@L["Ratio"]</h2>
    <div class="kaarten">
        <section>
            <table>
                <tbody>
                <tr>
                    <td>@L["CurrentRatio"]</td>
                    <td class="amount">@(overzicht.Ratio.CurrentRatio.HasValue ? overzicht.Ratio.CurrentRatio.Value.ToString("N2") : "–")</td>
                </tr>
                <tr>
                    <td>@L["QuickRatio"]</td>
                    <td class="amount">@(overzicht.Ratio.QuickRatio.HasValue ? overzicht.Ratio.QuickRatio.Value.ToString("N2") : "–")</td>
                </tr>
                </tbody>
            </table>
        </section>
        <section>
            <table>
                <tbody>
                <tr>
                    <td>@L["Solvabiliteit"]</td>
                    <td class="amount">@(overzicht.Ratio.Solvabiliteit.HasValue ? (overzicht.Ratio.Solvabiliteit.Value * 100m).ToString("N1") + "%" : "–")</td>
                </tr>
                <tr>
                    <td>@L["NettoWinstmarge"]</td>
                    <td class="amount">@(overzicht.Ratio.NettoWinstmarge.HasValue ? (overzicht.Ratio.NettoWinstmarge.Value * 100m).ToString("N1") + "%" : "–")</td>
                </tr>
                <tr>
                    <td>@L["RentabiliteitEigenVermogen"]</td>
                    <td class="amount">@(overzicht.Ratio.RentabiliteitEigenVermogen.HasValue ? (overzicht.Ratio.RentabiliteitEigenVermogen.Value * 100m).ToString("N1") + "%" : "–")</td>
                </tr>
                </tbody>
            </table>
        </section>
    </div>

    <p class="toolbar">
        <a href="@Url.Page("/Rapport", new { jaar = Model.Jaar })">@L["MenuRapport"]</a>
    </p>
}
