@page
@model FinOverzicht.Web.Pages.RapportModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MenuRapport"];
    var htmlUrl = Url.Page("/Rapport", "Html", new { rapport = Model.Sleutel, jaar = Model.Jaar });
    var csvUrl = Url.Page("/Rapport", "Csv", new { rapport = Model.Sleutel, jaar = Model.Jaar });
}
<h1>@L["MenuRapport"]</h1>
<p class="lead">
    @{
        var actief = Model.Rapporten.FirstOrDefault(r => r.Sleutel == Model.Sleutel);
    }
    @(actief is null ? string.Empty : Model.OmschrijvingVan(actief))
</p>

<form method="get" class="toolbar">
    <label for="rapport">@L["MenuRapport"]</label>
    <select id="rapport" name="rapport">
        @foreach (var definitie in Model.Rapporten)
        {
            <option value="@definitie.Sleutel" selected="@(Model.Sleutel == definitie.Sleutel)">@Model.TitelVan(definitie)</option>
        }
    </select>
    <label for="jaar">@L["Jaar"]</label>
    <input id="jaar" name="jaar" type="number" min="1900" max="2999" value="@Model.Jaar" />
    <button type="submit">@L["MenuRapport"]</button>
    <a href="@csvUrl">@L["DownloadCsv"]</a>
    <a href="@htmlUrl" target="_blank" rel="noopener">@L["Afdrukken"]</a>
</form>

@if (Model.Foutmelding is not null)
{
    <div class="melding">@Model.Foutmelding</div>
}

<iframe class="rapport-frame" src="@htmlUrl" title="@L["MenuRapport"]"></iframe>
