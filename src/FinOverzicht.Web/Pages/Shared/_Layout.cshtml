@using System.Globalization
@inject IStringLocalizer<SharedResource> L
@{
    var huidigeTaal = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var pad = Context.Request.Path.Value ?? "/";
    var bestaandeQuery = Context.Request.QueryString.Value ?? string.Empty;
    var scheidingsteken = string.IsNullOrEmpty(bestaandeQuery) ? "?" : "&";
}
<!DOCTYPE html>
<html lang="@huidigeTaal">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["AppTitel"]</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" href="/">@L["AppTitel"]</a>
    <nav>
        <a href="/">@L["MenuDashboard"]</a>
        <a href="/Rekeningen">@L["MenuRekeningen"]</a>
        <a href="/Boekingen">@L["MenuBoekingen"]</a>
        <a href="/Bankimport">@L["MenuBankimport"]</a>
        <a href="/Rapport">@L["MenuRapport"]</a>
    </nav>
    <div class="talen" title="@L["Taal"]">
        @foreach (var taal in Talen.Ondersteund)
        {
            <a class="@(huidigeTaal == taal ? "actief" : null)"
               href="@(pad + bestaandeQuery + scheidingsteken + "culture=" + taal)"
               hreflang="@taal"
               title="@Talen.Weergavenaam(taal)">@taal</a>
        }
    </div>
</header>
<main class="page">
    @RenderBody()
</main>
<footer class="voet">© @DateTime.Now.Year FinOverzicht — MIT</footer>
</body>
</html>
