@page
@model FinOverzicht.Web.Pages.BankimportModel
@using System.Globalization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["MenuBankimport"];
}
<h1>@L["MenuBankimport"]</h1>

@if (Model.Foutmelding is not null)
{
    <div class="melding">@Model.Foutmelding</div>
}

@if (Model.Resultaat is { } resultaat)
{
    <div class="melding">
        @L["ImportResultaat", resultaat.Gelezen, resultaat.Toegevoegd, resultaat.Overgeslagen]
        @if (resultaat.AllesAlBekend)
        {
            <span class="muted">@L["AllesAlBekend"]</span>
        }
    </div>
}

<h3>@L["AfschriftImporteren"]</h3>
<form method="post" asp-page-handler="Importeer" enctype="multipart/form-data">
    <div class="velden">
        <div class="veld">
            <label for="bankrekening">@L["Bankrekening"]</label>
            <select id="bankrekening" name="BankRekeningNummer" required>
                @foreach (var rekening in Model.AlleRekeningen)
                {
                    <option value="@rekening.Nummer" selected="@(Model.BankRekeningNummer == rekening.Nummer)">
                        @rekening.Nummer — @rekening.Naam
                    </option>
                }
            </select>
        </div>
        <div class="veld">
            <label for="formaat">@L["Formaat"]</label>
            <select id="formaat" name="Formaat">
                <option value="">@L["Automatisch"]</option>
                @foreach (var formaat in Model.Formaten)
                {
                    <option value="@formaat" selected="@(Model.Formaat == formaat)">@L[formaat.ToString()]</option>
                }
            </select>
        </div>
        <div class="veld">
            <label for="bestand">@L["Bestand"]</label>
            <input id="bestand" name="Bestand" type="file" accept=".xml,.csv,.txt" required />
        </div>
    </div>
    <button type="submit">@L["Importeren"]</button>
</form>

<h3>@L["OpenstaandeMutaties"]</h3>
<table>
    <thead>
    <tr>
        <th>@L["Datum"]</th>
        <th>@L["Bedrag"]</th>
        <th>@L["Naam"]</th>
        <th>@L["Omschrijving"]</th>
        <th>@L["Referentie"]</th>
        <th>@L["Voorstel"]</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @if (Model.Regels.Count == 0)
    {
        <tr><td colspan="7" class="muted">@L["GeenGegevens"]</td></tr>
    }
    @foreach (var regel in Model.Regels)
    {
        <tr>
            <td>@regel.Transactie.Datum.ToString("d", CultureInfo.CurrentCulture)</td>
            <td>@regel.Transactie.Mutatie.Waarde.ToString("N2", CultureInfo.CurrentCulture)</td>
            <td>@regel.Transactie.TegenpartijNaam</td>
            <td>@regel.Transactie.Omschrijving</td>
            <td>@regel.Transactie.Referentie</td>
            <td>
                @if (regel.Voorstel is { } voorstel)
                {
                    <span title="@voorstel.Reden">
                        @voorstel.TegenrekeningNummer — @voorstel.TegenrekeningNaam
                        (@L["Zekerheid"]: @voorstel.Zekerheid)
                    </span>
                }
                else
                {
                    <span class="muted">@L["GeenVoorstel"]</span>
                }
            </td>
            <td>
                <form method="post" asp-page-handler="Boek">
                    <input type="hidden" name="TransactieId" value="@regel.Transactie.Id" />
                    <select name="TegenrekeningNummer" aria-label="@L["Tegenrekening"]" required>
                        @foreach (var rekening in Model.AlleRekeningen)
                        {
                            var voorgesteld = regel.Voorstel is { IsBetrouwbaar: true } voorstel
                                && voorstel.TegenrekeningNummer == rekening.Nummer;
                            <option value="@rekening.Nummer" selected="@voorgesteld">
                                @rekening.Nummer — @rekening.Naam
                            </option>
                        }
                    </select>
                    <button type="submit">@L["Boeken"]</button>
                </form>
                <form method="post" asp-page-handler="Negeer">
                    <input type="hidden" name="TransactieId" value="@regel.Transactie.Id" />
                    <button type="submit">@L["Negeren"]</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
