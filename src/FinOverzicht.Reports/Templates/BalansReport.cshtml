@model FinancieelOverzichtModel
@{
    Layout = "_ReportLayout";
    var labels = (IReportLabels)ViewData["Labels"]!;
    var balans = Model.Overzicht.Balans;
}
<h2>@labels.Balans</h2>

<div class="columns">
    <section>
        <h3>@labels.Activa</h3>
        <table>
            <thead>
            <tr>
                <th>@labels.Rekening</th>
                <th>@labels.Omschrijving</th>
                <th class="amount">@labels.Bedrag</th>
            </tr>
            </thead>
            <tbody>
            @if (balans.Activa.Count == 0)
            {
                <tr><td colspan="3" class="empty">@labels.GeenGegevens</td></tr>
            }
            @foreach (var regel in balans.Activa)
            {
                <tr>
                    <td>@regel.Nummer</td>
                    <td>@regel.Omschrijving</td>
                    <td class="amount">@(regel.Bedrag.ToString("N2"))</td>
                </tr>
            }
            <tr class="total">
                <td colspan="2">@labels.Totaal @labels.Activa</td>
                <td class="amount">@(balans.TotaalActiva.ToString("N2"))</td>
            </tr>
            </tbody>
        </table>
    </section>

    <section>
        <h3>@labels.Passiva</h3>
        <table>
            <tbody>
            @if (balans.Passiva.Count == 0)
            {
                <tr><td colspan="2" class="empty">@labels.GeenGegevens</td></tr>
            }
            @foreach (var regel in balans.Passiva)
            {
                <tr>
                    <td>@regel.Nummer &mdash; @regel.Omschrijving</td>
                    <td class="amount">@(regel.Bedrag.ToString("N2"))</td>
                </tr>
            }
            <tr class="subtotal">
                <td>@labels.Totaal @labels.Passiva</td>
                <td class="amount">@(balans.TotaalPassiva.ToString("N2"))</td>
            </tr>
            </tbody>
        </table>

        <h3>@labels.EigenVermogen</h3>
        <table>
            <tbody>
            @foreach (var regel in balans.EigenVermogen)
            {
                <tr>
                    <td>@regel.Nummer &mdash; @regel.Omschrijving</td>
                    <td class="amount">@(regel.Bedrag.ToString("N2"))</td>
                </tr>
            }
            <tr>
                <td>@labels.Resultaat</td>
                <td class="amount @(balans.Resultaat < 0m ? "negative" : string.Empty)">@(balans.Resultaat.ToString("N2"))</td>
            </tr>
            <tr class="total">
                <td>@labels.Totaal @labels.EigenVermogen</td>
                <td class="amount">@(balans.EigenVermogenInclusiefResultaat.ToString("N2"))</td>
            </tr>
            </tbody>
        </table>
    </section>
</div>

<p>
    <span class="badge @(balans.IsInBalans ? "ok" : "warn")">
        @(balans.IsInBalans ? labels.InBalans : labels.NietInBalans)
    </span>
</p>
