<Project>

  <PropertyGroup>
    <!-- SharpCoreLedgerSheets always targets the newest stable .NET / C# combination.
         .NET 11 (RC) => C# 15. -->
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Microsoft code analysis: newest recommended ruleset. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisModeBehavior>Default</AnalysisModeBehavior>

    <!-- xUnit v3 test projects run on Microsoft.Testing.Platform (MTP) - see global.json "test.runner". -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- Repository metadata (OSS). -->
    <Authors>MPCoreDeveloper</Authors>
    <Company>MPCoreDeveloper</Company>
    <Product>SharpCoreLedgerSheets</Product>
    <Description>Double-entry bookkeeping engine with the three core financial statements (balance sheet, profit and loss, cash flow) and the key ratios, for the Dutch MKB and small businesses anywhere.</Description>
    <PackageTags>finance;accounting;bookkeeping;balance-sheet;profit-and-loss;cash-flow;ratios;mkb;dutch;sharpcoredb</PackageTags>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SharpCoreLedgerSheets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SharpCoreLedgerSheets</PackageProjectUrl>
    <VersionPrefix>2.2.0</VersionPrefix>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- SonarSource static analysis (C#) - latest stable.
         Note: SonarAnalyzer.CSharp is licensed under the "SONAR Source-Available License v1.0"
         (source-available, not OSI-approved OSS - see licenses/LICENSE.txt in the NuGet package).
         Deliberately accepted: that license only forbids building a product that competes with
         SonarQube, which does not apply here. The package uses PrivateAssets=all, so it is
         build-time only and is never shipped to customers. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
