{
  "stryker-config": {
    "project": "SharpCoreLedgerSheets.Infrastructure.csproj",
    "project-info": {
      "name": "SharpCoreLedgerSheets.Infrastructure",
      "module": "SharpCoreLedgerSheets.Infrastructure"
    },
    "mutation-level": "Standard",
    "language-version": "latest",
    "test-runner": "mtp",
    "concurrency": 4,
    "coverage-analysis": "perTest",
    "mutate": [
      "Banking/**/*.cs"
    ],
    "ignore-mutations": [
      "string"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "reporters": [
      "Progress",
      "Html",
      "Json",
      "Cleartext"
    ],
    "report-file-name": "infrastructure-mutation-report",
    "since": {
      "enabled": false,
      "target": "main"
    },
    "break-on-initial-test-failure": true
  }
}
